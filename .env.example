# Скопируйте в .env:  cp .env.example .env
# Для демо без Telegram (make simulate / make ui) достаточно ничего не менять.

# --- Telegram (только для режима бота: make bot) ---
TELEGRAM_BOT_TOKEN=
# id чата-хаба (супергруппа с темами). Можно оставить пустым и написать /sethub в хабе.
HUB_CHAT_ID=
# id чатов-источников через запятую; пусто = все чаты, где есть бот (кроме хаба)
SOURCE_CHAT_IDS=

# --- Локальная LLM через Ollama ---
OLLAMA_HOST=http://localhost:11434
# 16 ГБ RAM -> qwen3:8b ; 8 ГБ RAM -> qwen3:4b  (переключение — эта одна строка)
LLM_MODEL=qwen3:8b
EMBED_MODEL=bge-m3
TIMEZONE=Europe/Moscow
